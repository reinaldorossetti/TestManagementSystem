// Prisma schema for the Centro de Execução QA TMS relational store.
// Models mirror the legacy in-browser VirtualDatabase shape (src/utils/sqliteEngine.ts),
// now persisted in a real SQLite database via the libsql driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A single simulated Robot Framework suite execution.
model Execution {
  id          String     @id
  timestamp   String
  command     String
  durationS   Float      @map("duration_s")
  totalTests  Int        @map("total_tests")
  passed      Int
  failed      Int
  skipped     Int        @default(0)
  status      String
  resultsPath String     @map("results_path")
  resultsFolder String?  @map("results_folder")
  reportScreenshotPath String? @map("report_screenshot_path")
  createdAt   DateTime   @default(now()) @map("created_at")
  testCases   TestCase[]

  @@map("executions")
}

/// An individual scenario result belonging to an execution.
model TestCase {
  id          String    @id
  executionId String    @map("execution_id")
  name        String
  category    String
  status      String
  durationS   Float     @map("duration_s")
  robotTestId String?   @map("robot_test_id")
  reportScreenshotPath String? @map("report_screenshot_path")
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  steps       Step[]

  @@index([executionId])
  @@map("test_cases")
}

/// A single Gherkin/keyword step result belonging to a test case.
model Step {
  id         String   @id
  testCaseId String   @map("test_case_id")
  stepType   String   @map("step_type")
  text       String
  status     String
  screenshotPath String? @map("screenshot_path")
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("steps")
}

/// A saved feature specification (raw Gherkin/Robot content).
model TestSpec {
  id        String @id
  name      String
  category  String
  tags      String
  content   String
  createdAt String @map("created_at")

  @@map("test_specs")
}

/// A logical folder used to organize sphere test cases.
model TestFolder {
  path String @id

  @@map("test_folders")
}

/// Acceptance criteria markdown shared by all test cases in a folder/feature.
model FolderAcceptanceDoc {
  folderPath       String @id @map("folder_path")
  docTitle         String @map("doc_title")
  docWebPath       String @map("doc_web_path")
  repoRelativePath String @map("repo_relative_path")
  updatedAt        String @map("updated_at")

  @@map("folder_acceptance_docs")
}

/// Change history for an acceptance criteria document (per folder/feature).
model FolderAcceptanceDocHistory {
  id         Int    @id @default(autoincrement())
  folderPath String @map("folder_path")
  user       String @default("TMS")
  action     String
  summary    String @default("")
  time       String

  @@index([folderPath])
  @@map("folder_acceptance_doc_history")
}

/// A rich, editable test case (Sphere-style) with history.
model TestCaseSphere {
  id                  String                  @id
  folder              String
  title               String
  preconditions       String                  @default("")
  steps               String                  @default("")
  expectedResult      String                  @default("") @map("expected_result")
  observation         String?
  createdAt           String                  @map("created_at")
  lastExecutionStatus String?                 @map("last_execution_status")
  lastExecutionMode   String?                 @map("last_execution_mode")
  lastExecutedAt      String?                 @map("last_executed_at")
  history             TestCaseHistory[]
  manualExecutions    SphereManualExecution[]

  @@index([folder])
  @@map("test_cases_sphere")
}

/// Record of a manual QA execution for a sphere test case.
model SphereManualExecution {
  id         String         @id
  testCaseId String         @map("test_case_id")
  status     String
  notes      String         @default("")
  executedBy String         @default("Operador QA") @map("executed_by")
  executedAt String         @map("executed_at")
  durationS  Float?         @map("duration_s")
  testCase   TestCaseSphere @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("sphere_manual_executions")
}

/// An audit-trail entry for a sphere test case.
model TestCaseHistory {
  id         Int            @id @default(autoincrement())
  testCaseId String         @map("test_case_id")
  user       String
  action     String
  time       String
  testCase   TestCaseSphere @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_history")
}

/// Manual evidence uploaded for a sphere test case (images in DB, videos on disk, links as URL).
model TestCaseEvidence {
  id           String @id
  testCaseId   String @map("test_case_id")
  source       String @default("manual")
  evidenceType String @map("evidence_type")
  title        String @default("")
  mimeType     String? @map("mime_type")
  fileName     String? @map("file_name")
  imageData    Bytes?  @map("image_data")
  storagePath  String? @map("storage_path")
  externalUrl  String? @map("external_url")
  createdAt    String @map("created_at")
  createdBy    String @default("TMS") @map("created_by")

  @@index([testCaseId])
  @@map("test_case_evidence")
}
